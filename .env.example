# WebSocket / subscription
WS_URL=wss://ws.broker.ru/trade-api-market-data-connector/api/v1/market-data/ws
SOURCE=bks
SUBSCRIBE_CONFIG=subscribe_msg.yaml

# Secrets: set locally; never commit actual values
ACCESS_TOKEN=
REFRESH_TOKEN=
ACCESS_TOKEN_MAX_AGE_SEC=82800
AUTH_FAILED_EXIT_DELAY_SEC=600

# Existing ClickHouse: HTTP port, or HTTPS when secure=true
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=trades_raw_json
CLICKHOUSE_SECURE=false
CLICKHOUSE_CONNECT_TIMEOUT_SEC=5
CLICKHOUSE_IO_TIMEOUT_SEC=10

BATCH_SIZE=1000
FLUSH_INTERVAL_SEC=1.0
QUEUE_MAXSIZE=10000
RECONNECT_MIN_DELAY_SEC=1
RECONNECT_MAX_DELAY_SEC=60
SHUTDOWN_TIMEOUT_SEC=30
LOG_LEVEL=INFO
LOG_SUMMARY_INTERVAL_SEC=60
